# ==============================================================================
# VENTRA — Environment Configuration Template
# ==============================================================================
# Yalnızca istemci tarafında (Next.js & Capacitor) güvenli olan Public anahtarlar yer alır.
# SECRET veya SERVICE_ROLE anahtarları KESİNLİKLE buraya eklenmemelidir.
# ==============================================================================

# Gerçek Ventra Supabase Proje URL'si (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Gerçek Ventra Supabase Publishable / Anon Public Key (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# (Geriye dönük uyumluluk için Anon Key desteği)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

Resend_API_KEY=your-resend-api-key